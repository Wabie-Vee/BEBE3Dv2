if {Inventory.Key} == false:
	if {Menmo.talked_to_menmo} == false:
		Menmo: Hi Bebe!
		Menmo: I heard a lil something something about a key over there!
		do GameManager.camera_focus_on("NightStand")
		Menmo: Let me know if you grab it!
		do GameManager.camera_focus_reset()
	else:
		Menmo: Did you find the key?
else:
	Menmo: You found the key!